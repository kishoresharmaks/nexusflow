datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum PostStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  UNKNOWN_OUTCOME
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttemptStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

enum SocialProvider {
  META_INSTAGRAM
  META_FACEBOOK
  TIKTOK
  PINTEREST
  YOUTUBE
  TWITTER
  LINKEDIN
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum BillingOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum StorePlatform {
  SHOPIFY
  WOOCOMMERCE
  CUSTOM
}

enum StoreSyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserAccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  PENDING_ACCEPTANCE
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                               String            @id @default(auto()) @map("_id") @db.ObjectId
  email                            String            @unique
  passwordHash                     String
  name                             String
  accountStatus                    UserAccountStatus @default(ACTIVE)
  activationTokenHash              String?
  activationTokenExpiresAt         DateTime?
  activatedAt                      DateTime?
  isEmailVerified                  Boolean           @default(false)
  emailVerifiedAt                  DateTime?
  emailVerificationToken           String?
  emailVerificationTokenExpiresAt  DateTime?
  passwordResetToken               String?
  passwordResetTokenExpiresAt      DateTime?
  isSuspended                      Boolean           @default(false)
  suspendedAt                      DateTime?
  suspensionReason                 String?
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt

  sessions                         Session[]
  memberships                      Membership[]
  auditEvents                      AuditEvent[]
  notifications                    Notification[]
  platformAdmin                    PlatformAdmin?
}

model Session {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Workspace {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String              @unique
  timezone           String              @default("UTC")
  locale             String              @default("en-US")
  currency           String              @default("USD")
  status             WorkspaceStatus     @default(ACTIVE)
  suspendedAt        DateTime?
  suspensionReason   String?
  planTier           String              @default("FREE")
  customQuotas       Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  memberships        Membership[]
  products           Product[]
  catalogImports     CatalogImport[]
  mediaAssets        MediaAsset[]
  socialAccounts     SocialAccount[]
  brandProfiles      BrandProfile[]
  contentTemplates   ContentTemplate[]
  campaigns          Campaign[]
  posts              Post[]
  subscriptions      Subscription[]
  billingEvents      BillingEvent[]
  billingOrders      BillingOrder[]
  usageLedgers       UsageLedger[]
  aiUsages           AiUsage[]
  analyticsSnapshots AnalyticsSnapshot[]
  trackedClicks      TrackedClick[]
  conversionEvents   ConversionEvent[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  webhookEvents      WebhookEvent[]
  storeConnections   StoreConnection[]
  invitations        WorkspaceInvitation[]
  ownershipTransfers OwnershipTransfer[]
  approvalPolicy     ApprovalPolicy?
  trackingLinks      TrackingLink[]
}

model Membership {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String           @db.ObjectId
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String           @db.ObjectId
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             WorkspaceRole    @default(MEMBER)
  status           MembershipStatus @default(ACTIVE)
  suspendedAt      DateTime?
  suspensionReason String?
  joinedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([workspaceId, userId])
}

model WorkspaceInvitation {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String           @db.ObjectId
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailNormalized String
  role            WorkspaceRole
  status          InvitationStatus    @default(PENDING)
  emailDeliveryStatus EmailDeliveryStatus @default(PENDING)
  emailDeliveryError  String?
  tokenHash       String              @unique
  invitedByUserId String           @db.ObjectId
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([workspaceId, emailNormalized, createdAt])
  @@index([emailNormalized, expiresAt])
}

model OwnershipTransfer {
  id            String                  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String                  @db.ObjectId
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUserId    String                  @db.ObjectId
  toUserId      String                  @db.ObjectId
  status        OwnershipTransferStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([workspaceId, status, expiresAt])
  @@index([toUserId, status, expiresAt])
}

model ApprovalPolicy {
  id                             String          @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId                    String          @unique @db.ObjectId
  workspace                      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requiresApprovalBeforeSchedule Boolean         @default(false)
  requiresApprovalBeforePublish  Boolean         @default(true)
  allowedApproverRoles           WorkspaceRole[] @default([OWNER, ADMIN])
  updatedByUserId                String?         @db.ObjectId
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt
}

model Product {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String    @db.ObjectId
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku                String?
  title              String
  description        String?
  priceCents         Int
  currency           String    @default("USD")
  inventoryCount     Int       @default(0)
  url                String?
  images             String[]
  tags               String[]
  source             String    @default("MANUAL")
  sourceId           String?
  isActive           Boolean   @default(true)
  freshnessCheckedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts              Post[]

  @@index([workspaceId, isActive, updatedAt])
}

model CatalogImport {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String       @db.ObjectId
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName     String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  failedRows   Int          @default(0)
  errors       Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model MediaAsset {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String    @db.ObjectId
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storageKey       String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  width            Int?
  height           Int?
  url              String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SocialAccount {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId           String              @db.ObjectId
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider              SocialProvider
  providerAccountId     String
  displayName           String
  username              String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                String[]
  status                SocialAccountStatus @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  posts                 Post[]

  @@unique([workspaceId, provider, providerAccountId])
}

model BrandProfile {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String    @db.ObjectId
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  toneOfVoice       String?
  targetAudience    String?
  prohibitedWords   String[]
  preferredHashtags String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ContentTemplate {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String    @db.ObjectId
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  promptTemplate String
  channel        String?
  category       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Campaign {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String         @db.ObjectId
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  utmCampaign   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  posts         Post[]
  trackedClicks TrackedClick[]
  conversions   ConversionEvent[]
  trackingLinks TrackingLink[]

  @@index([workspaceId, createdAt])
}

model Post {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String           @db.ObjectId
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId      String?          @db.ObjectId
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  productId       String?          @db.ObjectId
  product         Product?         @relation(fields: [productId], references: [id])
  socialAccountId String?          @db.ObjectId
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id])
  status                  PostStatus       @default(DRAFT)
  content                 String
  mediaUrls               String[]
  scheduledAt             DateTime?
  publishedAt             DateTime?
  providerPostId          String?
  idempotencyKey          String?
  reconciliationAttempts  Int              @default(0)
  reconciliationDueAt     DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  approvals       Approval[]
  publishAttempts PublishAttempt[]

  @@index([workspaceId, status, scheduledAt])
}

model Approval {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  postId       String         @db.ObjectId
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewerId   String         @db.ObjectId
  status       ApprovalStatus
  decisionNotes String?
  decidedAt    DateTime       @default(now())
}

model PublishAttempt {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  postId            String        @db.ObjectId
  post              Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  status            AttemptStatus
  providerRequestId String?
  errorCode         String?
  errorMessage      String?
  isTransient       Boolean       @default(false)
  attemptedAt       DateTime      @default(now())

  @@unique([postId, attemptNumber])
}

model WebhookEvent {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String?    @db.ObjectId
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processed       Boolean    @default(false)
  processedAt     DateTime?
  createdAt       DateTime   @default(now())

  @@unique([provider, providerEventId])
}

model Subscription {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String             @db.ObjectId
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([workspaceId, status])
}

model BillingEvent {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String    @db.ObjectId
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerPaymentId String
  amountCents       Int
  currency          String    @default("USD")
  eventType         String
  metadata          Json?
  createdAt         DateTime  @default(now())
}

model BillingOrder {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String              @db.ObjectId
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId            String
  razorpayOrderId   String              @unique
  amountCents       Int
  currency          String              @default("USD")
  status            BillingOrderStatus  @default(PENDING)
  receipt           String?
  providerPaymentId String?
  confirmedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([workspaceId, createdAt])
}

model UsageLedger {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric       String
  quantity     Int
  balanceAfter Int
  description  String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model AiUsage {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId            String    @db.ObjectId
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider               String
  model                  String
  promptTokens           Int       @default(0)
  completionTokens       Int       @default(0)
  costEstimateMicrocents Int       @default(0)
  feature                String
  createdAt              DateTime  @default(now())
}

model AnalyticsSnapshot {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metricDate   DateTime
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  engagements  Int       @default(0)
  conversions  Int       @default(0)
  revenueCents Int       @default(0)
  createdAt    DateTime  @default(now())
}

model TrackedClick {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String            @db.ObjectId
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId     String?           @db.ObjectId
  campaign       Campaign?         @relation(fields: [campaignId], references: [id])
  trackingLinkId String?           @db.ObjectId
  trackingLink   TrackingLink?     @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  targetUrl      String
  referrer       String?
  country        String?
  userAgent      String?
  ipHash         String?
  clickedAt      DateTime          @default(now())

  conversions    ConversionEvent[]

  @@index([workspaceId, campaignId, clickedAt])
}

model ConversionEvent {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String        @db.ObjectId
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId        String?       @db.ObjectId
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clickId           String?       @db.ObjectId
  click             TrackedClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)
  orderId           String
  orderTotalCents   Int
  currency          String        @default("USD")
  attributionSource String?
  occurredAt        DateTime      @default(now())

  @@unique([workspaceId, orderId])
  @@index([workspaceId, campaignId, occurredAt])
}

model TrackingLink {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String         @db.ObjectId
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId     String?        @db.ObjectId
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  shortCode      String         @unique
  destinationUrl String
  utmSource      String
  utmMedium      String
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  clickCount     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  clicks         TrackedClick[]

  @@index([workspaceId, campaignId])
}

model Notification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?   @db.ObjectId
  user        User?     @relation(fields: [userId], references: [id])
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model AuditEvent {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String?   @db.ObjectId
  user         User?     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model StoreConnection {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String          @db.ObjectId
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform        StorePlatform
  storeName       String
  storeUrl        String
  encryptedApiKey String
  encryptedSecret String?
  apiVersion      String?
  lastSyncAt      DateTime?
  syncStatus      StoreSyncStatus @default(IDLE)
  errorMessage    String?
  syncedProducts  Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([workspaceId, platform, storeUrl])
}

model PlatformAdmin {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  userId           String              @unique @db.ObjectId
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             PlatformRole        @default(SUPER_ADMIN)
  status           PlatformAdminStatus @default(ACTIVE)
  permissions      String[]            @default([])
  createdBy        String?
  suspensionReason String?
  suspendedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String   @db.ObjectId
  actorEmail String
  action     String
  targetType String
  targetId   String?
  reason     String?
  outcome    String   @default("SUCCESS")
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model PlatformSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model AdminAnnouncement {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  audience    String    @default("ALL")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model EmailOutbox {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String?             @db.ObjectId
  to              String
  subject         String
  provider        String
  status          EmailDeliveryStatus @default(PENDING)
  errorMessage    String?
  attempts        Int                 @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([to, createdAt])
  @@index([workspaceId, createdAt])
}
