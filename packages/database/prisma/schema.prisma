datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum PostStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SocialProvider {
  META_INSTAGRAM
  META_FACEBOOK
  TIKTOK
  PINTEREST
  YOUTUBE
  TWITTER
  LINKEDIN
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum StorePlatform {
  SHOPIFY
  WOOCOMMERCE
  CUSTOM
}

enum StoreSyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

model User {
  id                               String         @id @default(auto()) @map("_id") @db.ObjectId
  email                            String         @unique
  passwordHash                     String
  name                             String
  isEmailVerified                  Boolean        @default(false)
  emailVerificationToken           String?
  emailVerificationTokenExpiresAt  DateTime?
  passwordResetToken               String?
  passwordResetTokenExpiresAt      DateTime?
  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @updatedAt

  sessions                         Session[]
  memberships                      Membership[]
  auditEvents                      AuditEvent[]
  notifications                    Notification[]
}

model Session {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Workspace {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String              @unique
  timezone           String              @default("UTC")
  locale             String              @default("en-US")
  currency           String              @default("USD")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  memberships        Membership[]
  products           Product[]
  catalogImports     CatalogImport[]
  mediaAssets        MediaAsset[]
  socialAccounts     SocialAccount[]
  brandProfiles      BrandProfile[]
  contentTemplates   ContentTemplate[]
  campaigns          Campaign[]
  posts              Post[]
  subscriptions      Subscription[]
  billingEvents      BillingEvent[]
  usageLedgers       UsageLedger[]
  aiUsages           AiUsage[]
  analyticsSnapshots AnalyticsSnapshot[]
  trackedClicks      TrackedClick[]
  conversionEvents   ConversionEvent[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  webhookEvents      WebhookEvent[]
  storeConnections   StoreConnection[]
  invitations        WorkspaceInvitation[]
  ownershipTransfers OwnershipTransfer[]
}

model Membership {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String        @db.ObjectId
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @db.ObjectId
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
}

model WorkspaceInvitation {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String        @db.ObjectId
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailNormalized String
  role            WorkspaceRole
  tokenHash       String        @unique
  invitedByUserId String        @db.ObjectId
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId, emailNormalized, createdAt])
  @@index([emailNormalized, expiresAt])
}

model OwnershipTransfer {
  id            String                  @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String                  @db.ObjectId
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromUserId    String                  @db.ObjectId
  toUserId      String                  @db.ObjectId
  status        OwnershipTransferStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([workspaceId, status, expiresAt])
  @@index([toUserId, status, expiresAt])
}

model Product {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String    @db.ObjectId
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku                String?
  title              String
  description        String?
  priceCents         Int
  currency           String    @default("USD")
  inventoryCount     Int       @default(0)
  url                String?
  images             String[]
  tags               String[]
  source             String    @default("MANUAL")
  sourceId           String?
  isActive           Boolean   @default(true)
  freshnessCheckedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts              Post[]

  @@index([workspaceId, isActive, updatedAt])
}

model CatalogImport {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String       @db.ObjectId
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName     String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  failedRows   Int          @default(0)
  errors       Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model MediaAsset {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String    @db.ObjectId
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storageKey       String
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  width            Int?
  height           Int?
  url              String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SocialAccount {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId           String              @db.ObjectId
  workspace             Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider              SocialProvider
  providerAccountId     String
  displayName           String
  username              String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                String[]
  status                SocialAccountStatus @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  posts                 Post[]

  @@unique([workspaceId, provider, providerAccountId])
}

model BrandProfile {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String    @db.ObjectId
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  toneOfVoice       String?
  targetAudience    String?
  prohibitedWords   String[]
  preferredHashtags String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ContentTemplate {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String    @db.ObjectId
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  promptTemplate String
  channel        String?
  category       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Campaign {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String         @db.ObjectId
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  utmCampaign   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  posts         Post[]
  trackedClicks TrackedClick[]
}

model Post {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String           @db.ObjectId
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId      String?          @db.ObjectId
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  productId       String?          @db.ObjectId
  product         Product?         @relation(fields: [productId], references: [id])
  socialAccountId String?          @db.ObjectId
  socialAccount   SocialAccount?   @relation(fields: [socialAccountId], references: [id])
  status          PostStatus       @default(DRAFT)
  content         String
  mediaUrls       String[]
  scheduledAt     DateTime?
  publishedAt     DateTime?
  providerPostId  String?
  idempotencyKey  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  approvals       Approval[]
  publishAttempts PublishAttempt[]

  @@index([workspaceId, status, scheduledAt])
}

model Approval {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  postId       String         @db.ObjectId
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewerId   String         @db.ObjectId
  status       ApprovalStatus
  decisionNotes String?
  decidedAt    DateTime       @default(now())
}

model PublishAttempt {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  postId            String        @db.ObjectId
  post              Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  status            AttemptStatus
  providerRequestId String?
  errorCode         String?
  errorMessage      String?
  isTransient       Boolean       @default(false)
  attemptedAt       DateTime      @default(now())

  @@unique([postId, attemptNumber])
}

model WebhookEvent {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String?    @db.ObjectId
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processed       Boolean    @default(false)
  processedAt     DateTime?
  createdAt       DateTime   @default(now())

  @@unique([provider, providerEventId])
}

model Subscription {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String             @db.ObjectId
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([workspaceId, status])
}

model BillingEvent {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String    @db.ObjectId
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerPaymentId String
  amountCents       Int
  currency          String    @default("USD")
  eventType         String
  metadata          Json?
  createdAt         DateTime  @default(now())
}

model UsageLedger {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metric       String
  quantity     Int
  balanceAfter Int
  description  String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model AiUsage {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId            String    @db.ObjectId
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider               String
  model                  String
  promptTokens           Int       @default(0)
  completionTokens       Int       @default(0)
  costEstimateMicrocents Int       @default(0)
  feature                String
  createdAt              DateTime  @default(now())
}

model AnalyticsSnapshot {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metricDate   DateTime
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  engagements  Int       @default(0)
  conversions  Int       @default(0)
  revenueCents Int       @default(0)
  createdAt    DateTime  @default(now())
}

model TrackedClick {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String?   @db.ObjectId
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  targetUrl   String
  referrer    String?
  country     String?
  clickedAt   DateTime  @default(now())
}

model ConversionEvent {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String    @db.ObjectId
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId           String
  orderTotalCents   Int
  currency          String    @default("USD")
  attributionSource String?
  occurredAt        DateTime  @default(now())
}

model Notification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?   @db.ObjectId
  user        User?     @relation(fields: [userId], references: [id])
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model AuditEvent {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String?   @db.ObjectId
  user         User?     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model StoreConnection {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String          @db.ObjectId
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform        StorePlatform
  storeName       String
  storeUrl        String
  encryptedApiKey String
  encryptedSecret String?
  apiVersion      String?
  lastSyncAt      DateTime?
  syncStatus      StoreSyncStatus @default(IDLE)
  errorMessage    String?
  syncedProducts  Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([workspaceId, platform, storeUrl])
}
