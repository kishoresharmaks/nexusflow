{
  "name": "@commercepilot/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
