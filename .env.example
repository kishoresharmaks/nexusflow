# Safe placeholders only; never commit real secrets.
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000

# Confirm current Prisma MongoDB connector/topology requirements.
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/commercepilot?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-long-random-development-secret
TOKEN_ENCRYPTION_KEY=replace-with-valid-key-format

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=commercepilot-local
S3_ACCESS_KEY_ID=local-placeholder
S3_SECRET_ACCESS_KEY=local-placeholder

AI_TEXT_PROVIDER=placeholder
AI_TEXT_API_KEY=replace-me
AI_IMAGE_PROVIDER=placeholder
AI_IMAGE_API_KEY=replace-me

META_CLIENT_ID=replace-with-meta-client-id
META_CLIENT_SECRET=replace-with-meta-client-secret
META_REDIRECT_URI=http://localhost:4000/api/integrations/instagram/callback

# LinkedIn OAuth 2.0 Credentials (Server-side only; never expose in frontend)
LINKEDIN_CLIENT_ID=replace-with-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/integrations/linkedin/callback

# Instagram OAuth 2.0 / Meta Graph API Credentials (Server-side only; never expose in frontend)
# META_APP_ID / META_APP_SECRET are aliases for INSTAGRAM_CLIENT_ID / INSTAGRAM_CLIENT_SECRET
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
INSTAGRAM_CLIENT_ID=replace-with-instagram-app-id
INSTAGRAM_CLIENT_SECRET=replace-with-instagram-app-secret
INSTAGRAM_CALLBACK_URL=http://localhost:4000/api/integrations/instagram/callback
META_GRAPH_API_VERSION=v21.0
FRONTEND_URL=http://localhost:3000

# Shopify App OAuth 2.0 Credentials (Server-side only; never expose in frontend)
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/auth/shopify/callback
SHOPIFY_SCOPES=read_products,read_inventory
SHOPIFY_API_VERSION=2026-01

RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

EMAIL_PROVIDER=local # local | smtp | brevo | msg91 | resend
EMAIL_FROM=NexusFlow <noreply@yourdomain.com> # Staging/production requires verified custom domain; .test/.example rejected
ALLOW_LOCAL_EMAIL_OUTBOX=false # Set to true only in dev or explicit sandbox testing

# SMTP Relay Configuration (Nodemailer TLS/STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp_username_placeholder
SMTP_PASS=smtp_password_placeholder

# Brevo (Sendinblue) Transactional API v3
BREVO_API_KEY=xkeysib_placeholder

# MSG91 Transactional Email API v5
MSG91_AUTH_KEY=msg91_authkey_placeholder
MSG91_DOMAIN=mail.example.com

# Resend API Configuration
EMAIL_API_KEY=re_placeholder
