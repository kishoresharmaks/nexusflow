# Safe placeholders only; never commit real secrets.
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000

# Confirm current Prisma MongoDB connector/topology requirements.
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/commercepilot?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-long-random-development-secret
TOKEN_ENCRYPTION_KEY=replace-with-valid-key-format

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=commercepilot-local
S3_ACCESS_KEY_ID=local-placeholder
S3_SECRET_ACCESS_KEY=local-placeholder

AI_TEXT_PROVIDER=placeholder
AI_TEXT_API_KEY=replace-me
AI_IMAGE_PROVIDER=placeholder
AI_IMAGE_API_KEY=replace-me

META_CLIENT_ID=replace-me
META_CLIENT_SECRET=replace-me
META_REDIRECT_URI=http://localhost:4000/api/v1/social-accounts/meta/callback

# LinkedIn OAuth 2.0 Credentials (Server-side only; never expose in frontend)
LINKEDIN_CLIENT_ID=replace-with-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/integrations/linkedin/callback

# Instagram OAuth 2.0 / Meta Graph API Credentials (Server-side only; never expose in frontend)
INSTAGRAM_CLIENT_ID=replace-with-instagram-app-id
INSTAGRAM_CLIENT_SECRET=replace-with-instagram-app-secret
INSTAGRAM_CALLBACK_URL=http://localhost:4000/api/integrations/instagram/callback
META_GRAPH_API_VERSION=v19.0
FRONTEND_URL=http://localhost:3000

RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

EMAIL_PROVIDER=placeholder
EMAIL_API_KEY=replace-me
EMAIL_FROM=CommercePilot <noreply@example.test>
